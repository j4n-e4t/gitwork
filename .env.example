# Copy to .env and fill in for local development (`wrangler dev` loads it; .env is git-ignored).
# In production, set these with `wrangler secret put <NAME>` instead.

# GitHub OAuth app: https://github.com/settings/developers -> OAuth Apps -> New OAuth App
# Authorization callback URL: <APP_URL>/auth/callback (local dev: http://localhost:5173/auth/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated GitHub logins allowed to sign in (bookmarks and hidden items are shared).
ALLOWED_USERS=

# Public origin of the app. Optional; defaults to the request's origin.
# Locally, set it to http://localhost:5173 so the OAuth callback goes through Vite.
# APP_URL=https://gitwork.jslop.fun
