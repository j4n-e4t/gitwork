{
  "expo": {
    "name": "gitwork",
    "slug": "gitwork",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fun.jslop.gitwork",
      "appleTeamId": "43HS4Y378Z",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "gitwork loads your work from the gitwork server on your local network."
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "scheme": "gitwork",
    "platforms": [
      "ios"
    ]
  }
}
